FROM ruby:4.0.9-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev libsqlite3-dev libvips libyaml-dev pkg-config zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

COPY Gemfile Gemfile.lock ./
RUN bundle install

RUN groupadd --system --gid 1000 rails && \
    useradd --uid 1000 --gid 1000 --create-home rails
COPY --chown=rails:rails . .
RUN mkdir -p storage var/autofacts tmp/pids log && chown -R rails:rails storage var tmp log

USER rails
